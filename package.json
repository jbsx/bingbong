{
  "name": "bingbong",
  "version": "0.1.0",
  "description": "Bing Bong — voice assistant with a live web-browsing dashboard",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' vitest run --config vitest.e2e.config.ts",
    "test:eval": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' vitest run --config vitest.eval.config.ts",
    "test:watch": "vitest",
    "cli": "pnpm build && electron . --browser-cli",
    "perf:report": "node scripts/perf-report.ts",
    "stt:replay": "node scripts/replay-stt.ts",
    "shot": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' node scripts/screenshot.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@modelcontextprotocol/sdk": "1.26.0",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node"
    ]
  }
}
