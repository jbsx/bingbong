{
  "name": "bingbong",
  "version": "0.1.0",
  "description": "Bing Bong (kachow) \u2014 a voice-driven browser shell: embedded Chromium with a numbered-ref interaction surface, dashboard, local STT/TTS, and Jev as the one model",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm build && electron-builder --linux AppImage --publish never",
    "release": "node scripts/release.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "cli": "pnpm build && electron . --browser-cli",
    "perf:report": "node scripts/perf-report.ts",
    "stt:replay": "node scripts/replay-stt.ts",
    "turn:replay": "node scripts/replay-turn.ts",
    "jev:replay": "node scripts/jev-replay.ts",
    "jev:gate": "node scripts/jev-gate.ts",
    "jev:candidates": "node scripts/jev-candidates.ts",
    "jev:case": "node scripts/jev-case.ts",
    "bugs": "node scripts/bugs.ts",
    "bugs:candidates": "node scripts/bugs-candidates.ts",
    "bugs:add": "node scripts/bugs-add.ts",
    "logs:pull": "node scripts/logs-pull.ts",
    "shot": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' node scripts/screenshot.ts",
    "shot:idle": "pnpm build && BINGBONG_IDLE_SHOT=1 xvfb-run -a -s '-screen 0 1920x1080x24' vitest run --config vitest.e2e.config.ts e2e/idleShot.e2e.test.ts",
    "shot:states": "pnpm build && xvfb-run -a -s '-screen 0 1280x800x24' vitest run --config vitest.e2e.config.ts e2e/stateShots.e2e.test.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@typesafe-ai/sdk": "0.7.0",
    "dbus-next": "^0.10.2",
    "electron-updater": "^6.8.11",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node"
    ]
  }
}
