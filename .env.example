# Bing Bong model routing — copy to config/.env and fill in.
# Layering: .env < process environment < the settings page's saved values.
# Any OpenAI-compatible provider works for any role.

# Orchestrator (and Vision via the same default key env) — e.g. the z.ai coding plan:
BINGBONG_ORCHESTRATOR_BASE_URL=https://ai.z.ai/api/coding/paas/v4
BINGBONG_ORCHESTRATOR_MODEL=glm-5.3
# BINGBONG_ORCHESTRATOR_API_KEY=sk-...          # or export ZAI_API_KEY instead
BINGBONG_VISION_BASE_URL=https://ai.z.ai/api/coding/paas/v4
BINGBONG_VISION_MODEL=glm-4.6v

# Subagent — e.g. DeepSeek:
BINGBONG_SUBAGENT_BASE_URL=https://api.deepseek.com/v1
BINGBONG_SUBAGENT_MODEL=deepseek-chat
# BINGBONG_SUBAGENT_API_KEY=sk-...              # or export DEEPSEEK_API_KEY instead
