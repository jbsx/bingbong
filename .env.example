# Bing Bong (kachow) — copy to config/.env and fill in.
# Layering: .env < process environment.

# The Decision Model (ADR 0068) — Jev answers typed questions in ~0.2 s and
# generates nothing. A key alone arms it; the base URL and the pinned model
# id default:
# export TYPESAFE_API_KEY, or set BINGBONG_DECISION_API_KEY, or name the env
# var holding the key with BINGBONG_DECISION_API_KEY_ENV.
# BINGBONG_DECISION_BASE_URL=https://api.typesafe.ai
# BINGBONG_DECISION_MODEL=jev-1.14.0
# The protocol it speaks; one today, /v1/systemone, which any of its hosts
# serves (TypeSafe, Baseten, OpenRouter, TrueFoundry). An unknown value
# leaves the role unconfigured.
# BINGBONG_DECISION_PROTOCOL=systemone
# How long one call may take before it is unavailable (a round's budget):
# BINGBONG_DECISION_TIMEOUT_MS=800
# false for a text-only model: an ask that carries an image (the Mark Ask)
# is then answered unavailable at once instead of sent.
# BINGBONG_DECISION_IMAGES=true
#
# Another model on the same protocol is env alone. Mammoth-1 on Baseten
# (text-only; p90 ~1.1 s, so the round's 800 ms is too short for it):
# BINGBONG_DECISION_BASE_URL=https://inference.baseten.co
# BINGBONG_DECISION_MODEL=decision-models/baseten-mammoth-27b-latest
# BINGBONG_DECISION_API_KEY_ENV=BASETEN_API_KEY
# BINGBONG_DECISION_IMAGES=false
# BINGBONG_DECISION_TIMEOUT_MS=1500

# The Story Brief writer (the News card's what-it-is and why-it-matters
# lines) — GLM on Z.ai's coding plan, off the Command path. A key alone
# arms it; the base URL and model default:
# export ZAI_API_KEY, or set BINGBONG_NEWS_WRITER_API_KEY, or name the env
# var holding the key with BINGBONG_NEWS_WRITER_API_KEY_ENV.
# BINGBONG_NEWS_WRITER_BASE_URL=https://api.z.ai/api/coding/paas/v4
# BINGBONG_NEWS_WRITER_MODEL=GLM-5.3

# The scripted stand-in (tests only): a JSON list, one answer per ask —
# {"answers": {…}} or {"unavailable": "<reason>"} — consumed in order.
# BINGBONG_DECISION_SCRIPT=
